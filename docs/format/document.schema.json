{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Heritiana-Ankatso/Kahie/docs/format/document.schema.json",
  "title": "Kahie document.json (format 0.2.0)",
  "description": "Human-readable current state of a notebook inside a .kahie file. See kahie-v0.md.",
  "type": "object",
  "required": ["format", "version", "notebook", "pages"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "kahie-document" },
    "version": { "type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+$" },
    "notebook": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "title": { "type": "string" } }
    },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["id", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "template": { "type": "string", "description": "Paper: lined, grid, dots, blank…", "default": "lined" },
        "size": { "anyOf": [{ "enum": ["a3", "a3-landscape", "a4", "a4-landscape", "a5", "a5-landscape", "letter", "letter-landscape", "infinite"] }, { "type": "string", "pattern": "^[0-9]{2,4}(\\.[0-9])?x[0-9]{2,4}(\\.[0-9])?mm$" }], "description": "Paper size: a named size, a custom size '<width>x<height>mm' (50–1000 mm per side), or 'infinite' (a canvas without edges; coordinates may be negative). Page units are 1/96 inch (A4 = 794 × 1123).", "default": "a4" },
        "items": { "type": "array", "description": "Bottom to top.", "items": { "$ref": "#/$defs/item" } },
        "groups": {
          "type": "object", "description": "Item id → group id. Items of a group are selected and moved together.",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "content": {
          "oneOf": [
            { "$ref": "#/$defs/stroke" },
            { "$ref": "#/$defs/text" },
            { "$ref": "#/$defs/math" },
            { "$ref": "#/$defs/plot" },
            { "$ref": "#/$defs/image" },
            { "$ref": "#/$defs/attachment" }
          ]
        }
      }
    },
    "color": { "type": "integer", "minimum": 0, "maximum": 16777215, "description": "0xRRGGBB" },
    "point": {
      "type": "object",
      "required": ["x", "y", "p"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "p": { "type": "number", "minimum": 0, "maximum": 1, "description": "Pressure; 0.5 when unknown" },
        "t": { "type": "number", "minimum": 0, "maximum": 1.5708, "description": "Pen tilt in radians from perpendicular; absent when 0 or unknown" }
      }
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "w": { "type": "number", "minimum": 0 }, "h": { "type": "number", "minimum": 0 }
      }
    },
    "label": { "enum": ["Circle", "Rectangle", "Triangle", null] },
    "shape": {
      "oneOf": [
        {
          "type": "object", "required": ["kind", "a", "b"], "additionalProperties": false,
          "properties": { "kind": { "const": "line" }, "a": { "$ref": "#/$defs/point" }, "b": { "$ref": "#/$defs/point" } }
        },
        {
          "type": "object", "required": ["kind", "points", "closed"], "additionalProperties": false,
          "properties": {
            "kind": { "const": "polygon" },
            "points": { "type": "array", "items": { "$ref": "#/$defs/point" } },
            "closed": { "type": "boolean" },
            "label": { "$ref": "#/$defs/label" }
          }
        },
        {
          "type": "object", "required": ["kind", "cx", "cy", "rx", "ry", "angle"], "additionalProperties": false,
          "properties": {
            "kind": { "const": "ellipse" },
            "cx": { "type": "number" }, "cy": { "type": "number" },
            "rx": { "type": "number" }, "ry": { "type": "number" }, "angle": { "type": "number" },
            "label": { "$ref": "#/$defs/label" }
          }
        }
      ]
    },
    "stroke": {
      "type": "object",
      "required": ["type", "tool", "color", "width", "points"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "stroke" },
        "tool": { "enum": ["pen", "highlighter", "pencil", "brush"], "description": "Readers that do not know a tool draw it as a pen." },
        "color": { "$ref": "#/$defs/color" },
        "width": { "type": "number", "minimum": 0 },
        "points": { "type": "array", "description": "Ink as displayed: the raw ink (never modified, ADR-0003) with any move, scale or rotation applied.", "items": { "$ref": "#/$defs/point" } },
        "interp": {
          "description": "Recognised shape; when show is true it is displayed instead of the raw ink.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "required": ["shape", "show"], "additionalProperties": false,
              "properties": { "shape": { "$ref": "#/$defs/shape" }, "show": { "type": "boolean" } }
            }
          ]
        }
      }
    },
    "text": {
      "type": "object",
      "required": ["type", "rect", "text", "size", "color"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "text" }, "rect": { "$ref": "#/$defs/rect" }, "text": { "type": "string" },
        "size": { "type": "number", "exclusiveMinimum": 0 }, "color": { "$ref": "#/$defs/color" },
        "spans": { "type": "array", "description": "Rich text formatting; absent for plain text.", "items": { "$ref": "#/$defs/span" } }
      }
    },
    "span": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "description": "Formatting of the characters [start, end) of the text, counted in Unicode scalar values. Spans are sorted and do not overlap.",
      "properties": {
        "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 },
        "bold": { "type": "boolean" }, "italic": { "type": "boolean" }, "underline": { "type": "boolean" },
        "color": { "$ref": "#/$defs/color" },
        "heading": { "type": "integer", "minimum": 0, "maximum": 3, "description": "Heading level of the paragraph (0: none)" },
        "list": { "type": "integer", "minimum": 0, "maximum": 2, "description": "List paragraph: 1 bullet, 2 numbered (0: none)" }
      }
    },
    "math": {
      "type": "object",
      "required": ["type", "rect", "latex", "size", "color"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "math" }, "rect": { "$ref": "#/$defs/rect" }, "latex": { "type": "string" },
        "size": { "type": "number", "exclusiveMinimum": 0 }, "color": { "$ref": "#/$defs/color" }
      }
    },
    "plot": {
      "type": "object",
      "required": ["type", "rect", "exprs", "x0", "x1", "y0", "y1"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "plot" }, "rect": { "$ref": "#/$defs/rect" },
        "exprs": { "type": "array", "items": { "type": "string" }, "description": "Functions of x, e.g. \"2sin(x)\"" },
        "x0": { "type": "number" }, "x1": { "type": "number" }, "y0": { "type": "number" }, "y1": { "type": "number" }
      }
    },
    "image": {
      "type": "object",
      "required": ["type", "rect", "asset"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "image" }, "rect": { "$ref": "#/$defs/rect" },
        "asset": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of assets/<hash>" }
      }
    },
    "attachment": {
      "type": "object",
      "required": ["type", "rect", "asset", "name", "mime"],
      "additionalProperties": false,
      "description": "Any other file, shown as a labelled box and opened with another app.",
      "properties": {
        "type": { "const": "attachment" }, "rect": { "$ref": "#/$defs/rect" },
        "asset": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of assets/<hash>" },
        "name": { "type": "string", "description": "File name" },
        "mime": { "type": "string", "description": "Media type, e.g. application/pdf" }
      }
    }
  }
}
