  "id": "1re-geo-001",
  "level": "premiere",
  "topic": "geometry",
  "statement": "Angle between (1,0) and (1,1) directions",
  "check": {
   "construction": [
    "O = (0, 0)",
    "A = (1, 0)",
    "B = (1, 1)",
    "a = angle(A, O, B)"
   ],
   "expect": {
    "a": 45
   }
  }
 },
 {
  "id": "1re-geo-002",
  "level": "premiere",
  "topic": "geometry",
  "statement": "Orthogonal projection of C(3, 4) on (AB), A(0,0), B(4,2)",
  "check": {
   "construction": [
    "A = (0, 0)",
    "B = (4, 2)",
    "C = (3, 4)",
    "l = line(A, B)",
    "p = perpendicular(l, C)",
    "H = intersect(l, p)"
   ],
   "expect": {
    "H": [
     4,
     2
    ]
   }
  }
 },
 {
  "id": "1re-geo-003",
  "level": "premiere",
  "topic": "geometry",
  "statement": "Circle-line: x-axis meets the circle centre (0,0) radius 5",
  "check": {
   "construction": [
    "O = (0, 0)",
    "A = (-1, 0)",
    "B = (1, 0)",
    "c = circle(O, 5)",
    "l = line(A, B)",
    "P = intersect(c, l, 1)",
    "Q = intersect(c, l, 2)",
    "d = distance(P, Q)"
   ],
   "expect": {
    "d": 10
   }
  }
 },
 {
  "id": "1re-geo-004",
  "level": "premiere",
  "topic": "geometry",
  "statement": "Two circles of radius 5 with centres 6 apart meet 8 apart",
  "check": {
   "construction": [
    "A = (0, 0)",
    "B = (6, 0)",
    "c1 = circle(A, 5)",
    "c2 = circle(B, 5)",
    "P = intersect(c1, c2, 1)",
    "Q = intersect(c1, c2, 2)",
    "d = distance(P, Q)"
   ],
   "expect": {
    "d": 8
   }
  }
 },
 {
  "id": "1re-geo-005",
  "level": "premiere",
  "topic": "geometry",
  "statement": "Angle bisector of a right angle passes through (1, 1)",
  "check": {
   "construction": [
    "O = (0, 0)",
    "A = (3, 0)",
    "B = (0, 3)",
    "b = anglebisector(A, O, B)",
    "C = (0, 2)",
    "D = (2, 2)",
    "h = line(C, D)",
    "I = intersect(b, h)"
   ],
   "expect": {
    "I": [
     2,
     2
    ]
   }
  }
 },
 {
  "id": "1re-geo-006",
  "level": "premiere",
  "topic": "geometry",
  "statement": "Homothety of centre O, ratio -2, of A(1, 3)",
  "check": {
   "construction": [
    "O = (0, 0)",
    "A = (1, 3)",
    "B = dilate(A, O, -2)"
   ],
   "expect": {
    "B": [
     -2,
     -6
    ]
   }
  }
 },
 {
  "id": "1re-geo-007",
  "level": "premiere",
  "topic": "geometry",
  "statement": "Inscribed angle: 90° in a semicircle",
  "check": {
   "construction": [
    "A = (-5, 0)",
    "B = (5, 0)",
    "C = (3, 4)",
    "a = angle(A, C, B)"
   ],
   "expect": {
    "a": 90
   }
  }
 }
]