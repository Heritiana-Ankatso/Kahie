  "check": {
   "construction": [
    "A = (0, 0)",
    "B = (4, 0)",
    "C = (0, 3)",
    "h = distance(B, C)"
   ],
   "expect": {
    "h": 5
   }
  }
 },
 {
  "id": "2de-geo-007",
  "level": "seconde",
  "topic": "geometry",
  "statement": "Circumcentre of the right triangle is the midpoint of the hypotenuse",
  "check": {
   "construction": [
    "A = (0, 0)",
    "B = (4, 0)",
    "C = (0, 3)",
    "m1 = bisector(A, B)",
    "m2 = bisector(A, C)",
    "O = intersect(m1, m2)"
   ],
   "expect": {
    "O": [
     2,
     1.5
    ]
   }
  }
 },
 {
  "id": "2de-geo-008",
  "level": "seconde",
  "topic": "geometry",
