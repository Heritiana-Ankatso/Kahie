 {
  "id": "tle-geo-001",
  "level": "terminale",
  "topic": "constructions",
  "statement": "Construct AB = 5 with AB horizontal (solver)",
  "check": {
   "constraints": [
    "A = (0, 0)",
    "B = (3, 1)",
    "constrain distance(A, B) = 5",
    "constrain horizontal(A, B)",
    "d = distance(A, B)"
   ],
   "expect": {
    "d": 5
   }
  }
 },
 {
  "id": "tle-geo-002",
  "level": "terminale",
  "topic": "constructions",
  "statement": "Right angle at A from rough positions (solver)",
  "check": {
   "constraints": [
    "A = (0, 0)",
    "B = (4, 0.5)",
    "C = (0.5, 3)",
    "constrain angle(B, A, C) = 90",
    "a = angle(B, A, C)"
   ],
   "expect": {
    "a": 90
   }
  }
 },
 {
  "id": "tle-geo-003",
  "level": "terminale",
  "topic": "constructions",
  "statement": "Isosceles triangle AB = AC = 4 (solver)",
  "check": {
   "constraints": [
    "A = (0, 3)",
    "B = (-2, 0)",
    "C = (2.5, 0)",
    "constrain distance(A, B) = 4",
    "constrain equal(A, B, A, C)",
    "b = distance(A, B)",
    "c = distance(A, C)"
   ],
   "expect": {
    "b": 4,
    "c": 4
   }
  }
 },
 {
  "id": "tle-geo-004",
  "level": "terminale",
  "topic": "constructions",
  "statement": "Contradictory lengths are reported (solver)",
  "check": {
   "constraints": [
    "A = (0, 0)",
    "B = (1, 0)",
    "C = (2, 0)",
    "constrain distance(A, B) = 1",
    "constrain distance(B, C) = 1",
    "constrain distance(A, C) = 5"
   ],
   "conflict": true,
   "expect": {}
  }
 },
 {
  "id": "tle-geo-005",
  "level": "terminale",
  "topic": "constructions",
  "statement": "Image of the circle (centre (1,0), r=2) by rotation 90° about O",
  "check": {
   "construction": [
    "O = (0, 0)",
    "A = (1, 0)",
    "c = circle(A, 2)",
    "d = rotate(c, O, 90)"
   ],
   "expect": {
    "d": {
     "c": [
      0,
      1
     ],
     "r": 2
    }
   }
  }
 }
]